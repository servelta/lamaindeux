# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for `npm run db:types`
SUPABASE_PROJECT_ID=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="LaMainDeux <contact@lamaindeux.fr>"
SUPPORT_EMAIL=

# --- SMS (Twilio) — optional, app must run fine with these unset ------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_ENABLED=false

# --- Stripe (Payment Links only — no Stripe Connect) ------------------------
# Fallback used if platform_settings.stripe_payment_link_url is empty.
STRIPE_PAYMENT_LINK_URL=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin bootstrap (see scripts/create-admin.ts) --------------------------
ADMIN_SETUP_SECRET=

# --- Cron (see app/api/cron/booking-reminders) ------------------------------
CRON_SECRET=
